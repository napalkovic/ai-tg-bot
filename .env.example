# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAE...

# Твой Telegram ID (узнать: @userinfobot). Несколько — через запятую.
# Бот отвечает только этим людям.
OWNER_IDS=111111111

# --- DeepSeek через веб-чат (бесплатно, неофициально) ----------------------
# Сессию создаёт скрипт ./scripts/ds_login.sh, отдельный токен не нужен.
DEEPSEEK_WEB_ENABLED=true
# Куда складывать токен и профиль браузера
# DEEPSEEK_SESSION_DIR=./session

# Опционально: вставить токен вручную (тогда браузер не нужен).
# Токен лежит в localStorage сайта chat.deepseek.com под ключом userToken.
# DEEPSEEK_TOKEN=
# DEEPSEEK_COOKIES={"ds_session_id":"..."}
# DEEPSEEK_USER_AGENT=Mozilla/5.0 ...

# Пауза между запросами к DeepSeek (секунды) — бережёт аккаунт от блокировок
DEEPSEEK_MIN_INTERVAL=3
# Пауза после ответа «слишком часто»
DEEPSEEK_COOLDOWN=60
# Как часто обновлять сессию из браузерного профиля (минуты)
DEEPSEEK_REFRESH_MINUTES=300
# Сколько часов доверять сохранённой сессии.
# На сервере без браузера поставь побольше (например, 720) — иначе бот будет
# считать токен протухшим, хотя он ещё рабочий.
DEEPSEEK_SESSION_MAX_HOURS=6

# --- Резервная бесплатная модель (если DeepSeek недоступен) ----------------
# Варианты: openrouter | groq | deepseek | custom | none
FALLBACK_PROVIDER=openrouter
# Ключ для выбранного провайдера (можно общий FALLBACK_API_KEY)
OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# Переопределить модель по умолчанию у резервного провайдера
# FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Своя OpenAI-совместимая точка (FALLBACK_PROVIDER=custom)
# FALLBACK_BASE_URL=https://api.example.com/v1
# FALLBACK_MODEL=some-model

# --- Картинки, фото и генерация ---------------------------------------------
# DeepSeek-веб фото не принимает, поэтому картинки смотрит «зрячая» модель
# резервного провайдера (OpenRouter даёт бесплатную vision-модель).
# VISION_PROVIDER=openrouter
# VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# Генерация картинок: «нарисуй …» или /image.
# По умолчанию работает бесплатный FLUX на Hugging Face — без регистрации,
# ключей и карты. Ничего заполнять не нужно.
#
# Не обязательно: Cloudflare Workers AI (FLUX.1 schnell) — быстрее и
# стабильнее. Бесплатно, без карты: 10 000 нейронов в день.
# Account ID и токен — в README.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Модель Cloudflare (менять не обязательно)
# IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Бесплатные генераторы (FLUX на Hugging Face + запасной Pollinations).
# Pollinations: лимит 1 картинка в 45 секунд. С токеном pollen лимита нет:
# https://enter.pollinations.ai
IMAGE_FREE_FALLBACK=true
POLLINATIONS_TOKEN=

# Какими бесплатными моделями рисуем (по умолчанию FLUX.1-dev, затем SD 3.5).
# Менять не обязательно; можно указать любое публичное HF-пространство Gradio
# с эндпоинтом /infer.
IMAGE_HF_SPACE=black-forest-labs/FLUX.1-dev
IMAGE_HF_SPACE_FALLBACK=stabilityai/stable-diffusion-3.5-large
IMAGE_HF_STEPS=24

# --- Видео по запросу («сгенерируй видео ...» или /video) -------------------
# Работает бесплатно через публичные HF-пространства (LTX-Video). Длина
# ролика по умолчанию 2 секунды (можно 2–5).
VIDEO_SECONDS=2

# Необязательный бесплатный токен Hugging Face (Settings → Access Tokens,
# права Read). Нужен только если бесплатная квота GPU на общих пространствах
# быстро кончается: с токеном и картинки, и видео срабатывают стабильнее.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- База данных ------------------------------------------------------------
# По умолчанию SQLite в data/bot.sqlite3 — этого хватает для домашнего сервера.
DB_PATH=./data/bot.sqlite3

# Для бесплатных хостингов с непостоянным диском — PostgreSQL (например, Neon).
# Формат: postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=

# Порт для мини-HTTP-сервера (нужен хостингам вроде Render / Koyeb).
# На Render задаётся автоматически, вручную добавлять не нужно.
# Локально оставь пустым — сервер не запустится.
# PORT=10000

# --- Поведение бота ---------------------------------------------------------
# Провайдер для новых чатов: deepseek_web или ключ резервного провайдера
DEFAULT_PROVIDER=deepseek_web

SYSTEM_PROMPT=Тебя зовут Бобби (Bobby). Ты — личный ИИ-ассистент. Отвечай на языке пользователя, по делу и без лишней воды. Оформляй ответы аккуратно. Ты никогда не называешь себя названием модели или компании — ты Бобби. Ты умеешь рисовать картинки по описанию, поэтому никогда не говори, что ты «только текстовый». На вопрос «кто ты» отвечай: «Я Бобби, твой личный ассистент».

# Сколько последних сообщений и символов истории отправлять модели
MEMORY_MAX_MESSAGES=40
MEMORY_MAX_CHARS=24000
# Необязательно: oauth-токен SoundCloud (cookie `oauth_token` со soundcloud.com).
# Задай — и даже «превью-обрезанные» треки будут скачиваться целиком.
SOUNDCLOUD_OAUTH_TOKEN=

# ВКонтакте (второй источник музыки). С 2026 музыка доступна только токенам
# «веб-клиента» или «мобильного» входа — обычные OAuth-токены VK закрыл.
# ОСНОВНОЙ путь без пароля: cookies твоего браузера (p + remixsid).
# Один раз на ноутбуке: py scripts/vk_cookies.py (вход в vk.com можно
# сделать по QR-коду с телефона). Скрипт печатает переменную для Render:
# VK_WEB_COOKIES=…
# Другие пути (если cookies не удастся):
# VK_AUDIO_TOKEN=… / VK_AUDIO_UA=… — из scripts/vk_auth.py (логин+пароль, SMS)
# VK_LOGIN=… VK_PASSWORD=… — бот войдёт сам (если VK не потребует SMS)
# /vklogin остаётся как запасная привязка аккаунта (музыку не открывает):
# VK_APP_ID — id приложения для входа (2685278 = Kate Mobile, есть scope audio).
# VK_OAUTH_APP_ID — если создаёте СВОЕ Standalone-приложение на dev.vk.com,
# впишите его client_id сюда (свободный scope audio есть только у Standalone).
VK_LOGIN=
VK_PASSWORD=
VK_AUDIO_TOKEN=
VK_AUDIO_UA=
VK_WEB_COOKIES=
VK_APP_ID=2685278
VK_OAUTH_APP_ID=
# Подмешивать краткое напоминание о недавней истории при продолжении ветки
# DeepSeek — чтобы он знал и те реплики, что шли через другие модели
# (например, описание фото от «зрячей» модели). false — отключить.
HISTORY_ON_RESUME=true

# Логи: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
